generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model BiometricSetting {
  userId           String    @id @map("user_id") @db.Uuid
  biometricEnabled Boolean?  @default(false) @map("is_enabled")
  biometricType    String?   @map("biometric_type") @db.VarChar(30)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  Profile          Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("biometric_settings")
  @@schema("public")
}

model CallLog {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId              String                  @map("family_id") @db.Uuid
  conversationId        String                  @map("conversation_id") @db.Uuid
  callerUserId          String                  @map("caller_id") @db.Uuid
  calleeUserId          String                  @map("receiver_id") @db.Uuid
  clientRequestId       String                  @map("client_request_id") @db.Uuid
  requestFingerprint    String                  @map("request_fingerprint") @db.VarChar(64)
  callType              String                  @map("call_type") @db.VarChar(20)
  status                String                  @default("ringing") @db.VarChar(30)
  createdAt             DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt             DateTime                @map("expires_at") @db.Timestamptz(6)
  acceptedAt            DateTime?               @map("accepted_at") @db.Timestamptz(6)
  terminalAt            DateTime?               @map("ended_at") @db.Timestamptz(6)
  legacyDurationSeconds Int?                    @map("duration_seconds")
  updatedAt             DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  caller                Profile                 @relation("call_logs_caller_idToprofiles", fields: [callerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  callee                Profile                 @relation("call_logs_receiver_idToprofiles", fields: [calleeUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  family                Family                  @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conversation          Conversation            @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeParticipants    CallActiveParticipant[]

  @@unique([callerUserId, clientRequestId], map: "call_logs_caller_request_key")
  @@index([callerUserId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_call_logs_caller_time")
  @@index([calleeUserId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_call_logs_receiver_time")
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_call_logs_conversation_time")
  @@index([status, expiresAt], map: "idx_call_logs_expiry")
  @@map("call_logs")
  @@schema("public")
}

model CallActiveParticipant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId    String   @map("call_id") @db.Uuid
  userId    String   @unique(map: "call_active_participants_user_key") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  call      CallLog  @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([callId, userId], map: "call_active_participants_call_user_key")
  @@index([callId], map: "idx_call_active_participants_call")
  @@map("call_active_participants")
  @@schema("public")
}

model Camera {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId             String      @map("family_id") @db.Uuid
  creatorUserId        String      @map("created_by") @db.Uuid
  name                 String      @map("camera_name") @db.VarChar(100)
  locationLabel        String?     @map("location_name") @db.VarChar(100)
  connectionUrl        String?     @map("stream_url")
  fallDetectionEnabled Boolean     @default(false) @map("is_fall_detection_enabled")
  status               String      @default("active") @db.VarChar(20)
  lastOnlineAt         DateTime?   @map("last_online_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  creator              Profile     @relation(fields: [creatorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  family               Family      @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fallEvents           FallEvent[]

  @@index([familyId, status], map: "idx_cameras_family_status")
  @@map("cameras")
  @@schema("public")
}

model ConversationMember {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId           String       @map("conversation_id") @db.Uuid
  userId                   String       @map("user_id") @db.Uuid
  isActive                 Boolean      @default(true) @map("is_active")
  joinedAt                 DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt                DateTime?    @map("removed_at") @db.Timestamptz(6)
  lastReadMessageId        String?      @map("last_read_message_id") @db.Uuid
  lastReadMessageCreatedAt DateTime?    @map("last_read_message_created_at") @db.Timestamptz(6)
  lastReadAt               DateTime?    @map("last_read_at") @db.Timestamptz(6)
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  profile                  Profile      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lastReadMessage          Message?     @relation("conversation_member_read_cursor", fields: [lastReadMessageId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([conversationId, userId])
  @@index([conversationId], map: "idx_conversation_members_conversation")
  @@index([userId], map: "idx_conversation_members_user")
  @@map("conversation_members")
  @@schema("public")
}

model Conversation {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId  String               @map("family_id") @db.Uuid
  title     String?              @db.VarChar(100)
  type      String               @default("direct") @map("conversation_type") @db.VarChar(20)
  directKey String?              @map("direct_key") @db.VarChar(73)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  members   ConversationMember[]
  family    Family               @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  messages  Message[]
  calls     CallLog[]

  @@unique([familyId, directKey], map: "conversations_family_direct_key")
  @@index([familyId, type], map: "idx_conversations_family_type")
  @@map("conversations")
  @@schema("public")
}

model CurrentLocation {
  userId       String        @id @map("user_id") @db.Uuid
  memberId     String?       @map("member_id") @db.Uuid
  deviceId     String        @map("device_id") @db.Uuid
  locationId   String        @unique(map: "current_locations_location_id_key") @map("location_id") @db.Uuid
  latitude     Decimal       @db.Decimal(10, 7)
  longitude    Decimal       @db.Decimal(10, 7)
  accuracy     Float?
  batteryLevel Int?          @map("battery_level")
  recordedAt   DateTime      @map("recorded_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  member       FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  source       Location      @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([memberId], map: "idx_current_locations_member")
  @@index([deviceId], map: "idx_current_locations_device")
  @@map("current_locations")
  @@schema("public")
}

model DailyStatusReport {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId                String       @map("family_id") @db.Uuid
  memberId                String       @map("member_id") @db.Uuid
  subjectUserId           String       @map("subject_user_id") @db.Uuid
  reportDate              DateTime     @map("report_date") @db.Date
  timezone                String       @db.VarChar(100)
  dayStart                DateTime     @map("day_start") @db.Timestamptz(6)
  dayEnd                  DateTime     @map("day_end") @db.Timestamptz(6)
  schemaVersion           Int          @default(1) @map("schema_version")
  summary                 Json
  generatedAt             DateTime     @default(now()) @map("generated_at") @db.Timestamptz(6)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  legacyLocationSummary   String?      @map("location_summary")
  legacyPhoneUsageSummary String?      @map("phone_usage_summary")
  legacyReminderSummary   String?      @map("reminder_summary")
  legacyFallRiskLevel     String?      @map("fall_risk_level") @db.VarChar(20)
  legacyActivityLevel     String?      @map("activity_level") @db.VarChar(20)
  legacyAiSummary         String?      @map("ai_summary")
  legacyAiData            Json?        @map("ai_data")
  family                  Family       @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  member                  FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  subject                 Profile      @relation(fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([familyId, subjectUserId, reportDate, timezone], map: "daily_status_reports_context_key")
  @@index([subjectUserId, reportDate(sort: Desc), id(sort: Desc)], map: "idx_daily_reports_subject_date")
  @@index([familyId, memberId, reportDate(sort: Desc), id(sort: Desc)], map: "idx_daily_reports_family_member_date")
  @@map("daily_status_reports")
  @@schema("public")
}

model Device {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  deviceName           String?                @map("device_name") @db.VarChar(100)
  platform             String                 @map("device_type") @db.VarChar(30)
  operatingSystem      String?                @map("os") @db.VarChar(30)
  installationId       String                 @unique(map: "devices_installation_id_key") @map("device_identifier")
  fcmToken             String?                @unique(map: "devices_fcm_token_key") @map("fcm_token")
  batteryLevel         Int?                   @map("battery_level")
  isActive             Boolean                @default(true) @map("is_active")
  lastSeenAt           DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner                Profile                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  CurrentLocation      CurrentLocation[]
  FallEvent            FallEvent[]
  Location             Location[]
  PhoneCommand         PhoneCommand[]
  PhoneUsageLog        PhoneUsageLog[]
  NotificationDelivery NotificationDelivery[]
  SosEvent             SosEvent[]

  @@index([userId], map: "idx_devices_user")
  @@map("devices")
  @@schema("public")
}

model FallEvent {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id        String       @db.Uuid
  member_id        String       @db.Uuid
  source_type      String       @db.VarChar(30)
  device_id        String?      @db.Uuid
  camera_id        String?      @db.Uuid
  confidence_score Float?
  status           String?      @default("detected") @db.VarChar(30)
  latitude         Decimal?     @db.Decimal(10, 7)
  longitude        Decimal?     @db.Decimal(10, 7)
  image_url        String?
  video_url        String?
  sensor_data      Json?
  ai_result        Json?
  detected_at      DateTime?    @default(now()) @db.Timestamptz(6)
  resolved_by      String?      @db.Uuid
  resolved_at      DateTime?    @db.Timestamptz(6)
  note             String?
  Camera           Camera?      @relation(fields: [camera_id], references: [id], onUpdate: NoAction)
  Device           Device?      @relation(fields: [device_id], references: [id], onUpdate: NoAction)
  Family           Family       @relation(fields: [family_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  FamilyMember     FamilyMember @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Profile          Profile?     @relation(fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([family_id, detected_at(sort: Desc)], map: "idx_fall_events_family_time")
  @@index([member_id, detected_at(sort: Desc)], map: "idx_fall_events_member_time")
  @@map("fall_events")
  @@schema("public")
}

model Family {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyName         String              @map("family_name") @db.VarChar(100)
  ownerUserId        String              @map("owner_user_id") @db.Uuid
  avatarUrl          String?             @map("avatar_url")
  inviteCode         String?             @unique @map("invite_code") @db.VarChar(20)
  status             String              @default("active") @db.VarChar(20)
  createdAt          DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime?           @default(now()) @map("updated_at") @db.Timestamptz(6)
  CallLog            CallLog[]
  Camera             Camera[]
  Conversation       Conversation[]
  dailyStatusReports DailyStatusReport[]
  FallEvent          FallEvent[]
  owner              Profile             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members            FamilyMember[]
  GeofenceEvent      GeofenceEvent[]
  GeofenceMember     GeofenceMember[]
  GeofenceState      GeofenceState[]
  Geofence           Geofence[]
  Notification       Notification[]
  PhoneRule          PhoneRule[]
  PhoneCommand       PhoneCommand[]
  reminders          Reminder[]
  SosEvent           SosEvent[]

  @@index([ownerUserId], map: "idx_families_owner")
  @@map("families")
  @@schema("public")
}

model FamilyMember {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId               String              @map("family_id") @db.Uuid
  userId                 String              @map("user_id") @db.Uuid
  invitedByUserId        String?             @map("invited_by_user_id") @db.Uuid
  role                   String              @db.VarChar(30)
  familyLabel            String              @map("family_label") @db.VarChar(50)
  displayName            String?             @map("display_name") @db.VarChar(100)
  status                 String              @default("pending") @db.VarChar(30)
  locationSharingEnabled Boolean?            @default(true) @map("location_sharing_enabled")
  invitedAt              DateTime?           @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt             DateTime?           @map("accepted_at") @db.Timestamptz(6)
  removedAt              DateTime?           @map("removed_at") @db.Timestamptz(6)
  createdAt              DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime?           @default(now()) @map("updated_at") @db.Timestamptz(6)
  CurrentLocation        CurrentLocation[]
  dailyStatusReports     DailyStatusReport[]
  FallEvent              FallEvent[]
  family                 Family              @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter                Profile?            @relation("family_members_invited_by_user_idToprofiles", fields: [invitedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profile                Profile             @relation("family_members_user_idToprofiles", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  GeofenceEvent          GeofenceEvent[]
  GeofenceMember         GeofenceMember[]
  GeofenceState          GeofenceState[]
  Location               Location[]
  PhoneRule              PhoneRule[]
  PhoneCommand           PhoneCommand[]
  PhoneUsageLog          PhoneUsageLog[]
  reminderLogs           ReminderLog[]
  reminderTargets        ReminderTarget[]
  SosContact             SosContact[]
  SosEvent               SosEvent[]

  @@unique([familyId, userId])
  @@index([familyId], map: "idx_family_members_family")
  @@index([familyId, status], map: "idx_family_members_family_status")
  @@index([status], map: "idx_family_members_status")
  @@index([userId], map: "idx_family_members_user")
  @@index([userId, status], map: "idx_family_members_user_status")
  @@map("family_members")
  @@schema("public")
}

model GeofenceEvent {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id    String       @db.Uuid
  geofence_id  String       @db.Uuid
  member_id    String       @db.Uuid
  location_id  String?      @db.Uuid
  event_type   String       @db.VarChar(20)
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  detected_at  DateTime     @default(now()) @db.Timestamptz(6)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  Family       Family       @relation(fields: [family_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Geofence     Geofence     @relation(fields: [geofence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  FamilyMember FamilyMember @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Location     Location?    @relation(fields: [location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([geofence_id, member_id, location_id])
  @@index([family_id, detected_at(sort: Desc)], map: "idx_geofence_events_family_time")
  @@index([geofence_id, detected_at(sort: Desc)], map: "idx_geofence_events_geofence_time")
  @@index([member_id, detected_at(sort: Desc)], map: "idx_geofence_events_member_time")
  @@map("geofence_events")
  @@schema("public")
}

model GeofenceMember {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id       String       @db.Uuid
  geofence_id     String       @db.Uuid
  member_id       String       @db.Uuid
  notify_on_enter Boolean      @default(true)
  notify_on_exit  Boolean      @default(true)
  Geofence        Geofence     @relation(fields: [geofence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  FamilyMember    FamilyMember @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Family          Family       @relation(fields: [family_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([geofence_id, member_id])
  @@index([family_id], map: "idx_geofence_members_family")
  @@index([member_id], map: "idx_geofence_members_member")
  @@map("geofence_members")
  @@schema("public")
}

model Geofence {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id        String           @db.Uuid
  created_by       String           @db.Uuid
  name             String           @db.VarChar(100)
  address          String?
  center_latitude  Decimal          @db.Decimal(10, 7)
  center_longitude Decimal          @db.Decimal(10, 7)
  radius_meters    Int
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  GeofenceEvent    GeofenceEvent[]
  GeofenceMember   GeofenceMember[]
  GeofenceState    GeofenceState[]
  Profile          Profile          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Family           Family           @relation(fields: [family_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([family_id], map: "idx_geofences_family")
  @@map("geofences")
  @@schema("public")
}

model GeofenceState {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id        String       @db.Uuid
  geofence_id      String       @db.Uuid
  member_id        String       @db.Uuid
  is_inside        Boolean
  last_location_id String       @db.Uuid
  last_recorded_at DateTime     @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)
  Family           Family       @relation(fields: [family_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Geofence         Geofence     @relation(fields: [geofence_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  FamilyMember     FamilyMember @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Location         Location     @relation(fields: [last_location_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([geofence_id, member_id])
  @@index([member_id], map: "idx_geofence_states_member")
  @@map("geofence_states")
  @@schema("public")
}

model Location {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  memberId        String?          @map("member_id") @db.Uuid
  deviceId        String           @map("device_id") @db.Uuid
  latitude        Decimal          @db.Decimal(10, 7)
  longitude       Decimal          @db.Decimal(10, 7)
  accuracy        Float?
  speed           Float?
  heading         Float?
  batteryLevel    Int?             @map("battery_level")
  recordedAt      DateTime         @map("recorded_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  owner           Profile          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  device          Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  member          FamilyMember?    @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  CurrentLocation CurrentLocation?
  GeofenceEvent   GeofenceEvent[]
  GeofenceState   GeofenceState[]
  SosEvent        SosEvent[]

  @@index([memberId, recordedAt(sort: Desc)], map: "idx_locations_member_time")
  @@index([userId, recordedAt(sort: Desc), id(sort: Desc)], map: "idx_locations_user_time_id")
  @@index([deviceId, recordedAt(sort: Desc)], map: "idx_locations_device_time")
  @@map("locations")
  @@schema("public")
}

model Message {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId     String               @map("conversation_id") @db.Uuid
  senderUserId       String               @map("sender_id") @db.Uuid
  clientMessageId    String               @map("client_message_id") @db.Uuid
  requestFingerprint String               @map("request_fingerprint") @db.VarChar(64)
  type               String               @default("text") @map("message_type") @db.VarChar(20)
  content            String
  mediaUrl           String?              @map("media_url")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  legacyReadAt       DateTime?            @map("read_at") @db.Timestamptz(6)
  conversation       Conversation         @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sender             Profile              @relation(fields: [senderUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  readCursors        ConversationMember[] @relation("conversation_member_read_cursor")

  @@unique([conversationId, senderUserId, clientMessageId], map: "messages_conversation_sender_client_key")
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_messages_conversation_time")
  @@map("messages")
  @@schema("public")
}

model Notification {
  id                                                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  family_id                                          String?                @db.Uuid
  recipient_user_id                                  String                 @db.Uuid
  sender_user_id                                     String?                @db.Uuid
  notification_type                                  String                 @db.VarChar(40)
  title                                              String                 @db.VarChar(150)
  message                                            String
  related_table                                      String?                @db.VarChar(50)
  related_id                                         String?                @db.Uuid
  metadata                                           Json                   @default("{}")
  is_read                                            Boolean                @default(false)
  read_at                                            DateTime?              @db.Timestamptz(6)
  created_at                                         DateTime               @default(now()) @db.Timestamptz(6)
  Family                                             Family?                @relation(fields: [family_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_notifications_recipient_user_idToprofiles Profile                @relation("notifications_recipient_user_idToprofiles", fields: [recipient_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_notifications_sender_user_idToprofiles    Profile?               @relation("notifications_sender_user_idToprofiles", fields: [sender_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries                                         NotificationDelivery[]

  @@unique([recipient_user_id, related_table, related_id], map: "notifications_recipient_source_key")
  @@index([recipient_user_id, created_at(sort: Desc)], map: "idx_notifications_recipient_time")
  @@index([recipient_user_id, is_read], map: "idx_notifications_unread")
  @@map("notifications")
  @@schema("public")
}

model NotificationDelivery {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  deviceId       String       @map("device_id") @db.Uuid
  status         String       @default("pending") @db.VarChar(20)
  attemptCount   Int          @default(0) @map("attempt_count")
  lastAttemptAt  DateTime?    @map("last_attempt_at") @db.Timestamptz(6)
  sentAt         DateTime?    @map("sent_at") @db.Timestamptz(6)
  errorCategory  String?      @map("error_category") @db.VarChar(40)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([notificationId, deviceId])
  @@index([status, createdAt], map: "idx_notification_deliveries_status_created")
  @@index([deviceId], map: "idx_notification_deliveries_device")
  @@map("notification_deliveries")
  @@schema("public")
}

model PhoneCommand {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId           String       @map("family_id") @db.Uuid
  memberId           String       @map("member_id") @db.Uuid
  targetDeviceId     String       @map("target_device_id") @db.Uuid
  creatorUserId      String       @map("created_by") @db.Uuid
  clientRequestId    String       @map("client_request_id") @db.Uuid
  requestFingerprint String       @map("request_fingerprint") @db.VarChar(64)
  commandType        String       @map("command_type") @db.VarChar(30)
  commandPayload     Json?        @map("command_payload")
  status             String       @default("pending") @db.VarChar(30)
  resultCode         String?      @map("result_code") @db.VarChar(50)
  resultMessage      String?      @map("result_message") @db.VarChar(300)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  sentAt             DateTime?    @map("sent_at") @db.Timestamptz(6)
  acknowledgedAt     DateTime?    @map("executed_at") @db.Timestamptz(6)
  creator            Profile      @relation(fields: [creatorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  family             Family       @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  member             FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targetDevice       Device       @relation(fields: [targetDeviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([creatorUserId, clientRequestId], map: "phone_commands_creator_request_key")
  @@index([targetDeviceId, status, createdAt(sort: Desc), id(sort: Desc)], map: "idx_phone_commands_device_status_time")
  @@index([familyId, memberId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_phone_commands_family_member_time")
  @@map("phone_commands")
  @@schema("public")
}

model PhoneRule {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId          String       @map("family_id") @db.Uuid
  memberId          String       @map("member_id") @db.Uuid
  creatorUserId     String       @map("created_by") @db.Uuid
  dailyLimitMinutes Int?         @map("daily_limit_minutes")
  bedtimeStart      DateTime?    @map("bedtime_start") @db.Time(6)
  bedtimeEnd        DateTime?    @map("bedtime_end") @db.Time(6)
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  creator           Profile      @relation(fields: [creatorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  family            Family       @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  member            FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([familyId, memberId], map: "phone_rules_family_member_key")
  @@index([memberId, isActive], map: "idx_phone_rules_member_active")
  @@map("phone_rules")
  @@schema("public")
}

model PhoneUsageLog {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId           String       @map("member_id") @db.Uuid
  deviceId           String       @map("device_id") @db.Uuid
  clientRecordId     String       @map("client_record_id") @db.Uuid
  requestFingerprint String       @map("request_fingerprint") @db.VarChar(64)
  appName            String?      @map("app_name") @db.VarChar(100)
  appPackage         String       @map("app_package") @db.VarChar(150)
  startedAt          DateTime     @map("start_time") @db.Timestamptz(6)
  endedAt            DateTime     @map("end_time") @db.Timestamptz(6)
