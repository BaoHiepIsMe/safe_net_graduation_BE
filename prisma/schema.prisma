  device             Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  member             FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([deviceId, clientRecordId], map: "phone_usage_device_record_key")
  @@index([memberId, startedAt(sort: Desc), id(sort: Desc)], map: "idx_phone_usage_member_time")
  @@index([deviceId, startedAt(sort: Desc), id(sort: Desc)], map: "idx_phone_usage_device_time")
  @@map("phone_usage_logs")
  @@schema("public")
}

model Profile {
  id                                                         String                  @id @db.Uuid
  fullName                                                   String?                 @map("full_name") @db.VarChar(100)
  email                                                      String?                 @unique @db.VarChar(150)
  phoneNumber                                                String?                 @unique @map("phone") @db.VarChar(20)
  avatarUrl                                                  String?                 @map("avatar_url")
  dateOfBirth                                                DateTime?               @map("date_of_birth") @db.Date
  gender                                                     String?                 @db.VarChar(20)
  accountStatus                                              String?                 @default("active") @map("account_status") @db.VarChar(20)
  createdAt                                                  DateTime?               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                  DateTime?               @default(now()) @map("updated_at") @db.Timestamptz(6)
  BiometricSetting                                           BiometricSetting?
  call_logs_call_logs_caller_idToprofiles                    CallLog[]               @relation("call_logs_caller_idToprofiles")
  call_logs_call_logs_receiver_idToprofiles                  CallLog[]               @relation("call_logs_receiver_idToprofiles")
  CallActiveParticipant                                      CallActiveParticipant[]
  Camera                                                     Camera[]
  ConversationMember                                         ConversationMember[]
  CurrentLocation                                            CurrentLocation?
  dailyStatusReports                                         DailyStatusReport[]
  Device                                                     Device[]
  FallEvent                                                  FallEvent[]
  Family                                                     Family[]
  family_members_family_members_invited_by_user_idToprofiles FamilyMember[]          @relation("family_members_invited_by_user_idToprofiles")
  family_members_family_members_user_idToprofiles            FamilyMember[]          @relation("family_members_user_idToprofiles")
  Geofence                                                   Geofence[]
  Location                                                   Location[]
  Message                                                    Message[]
  notifications_notifications_recipient_user_idToprofiles    Notification[]          @relation("notifications_recipient_user_idToprofiles")
  notifications_notifications_sender_user_idToprofiles       Notification[]          @relation("notifications_sender_user_idToprofiles")
  PhoneCommand                                               PhoneCommand[]
  PhoneRule                                                  PhoneRule[]
  remindersCreated                                           Reminder[]
  sosContactsOwned                                           SosContact[]            @relation("sos_contacts_owner")
  sosContactsLinked                                          SosContact[]            @relation("sos_contacts_linked_user")
  sosEventsTriggered                                         SosEvent[]              @relation("sos_events_actor")
  sosEventsHandled                                           SosEvent[]              @relation("sos_events_handled_by")
  SosRecipient                                               SosRecipient[]
  UserSetting                                                UserSetting?

  @@index([email], map: "idx_profiles_email")
  @@index([phoneNumber], map: "idx_profiles_phone")
  @@map("profiles")
  @@schema("public")
}

model ReminderLog {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reminderId              String       @map("reminder_id") @db.Uuid
  memberId                String       @map("member_id") @db.Uuid
  scheduledAt             DateTime     @map("scheduled_at") @db.Timestamptz(6)
  status                  String       @default("due") @db.VarChar(30)
  notificationProcessedAt DateTime?    @map("notification_processed_at") @db.Timestamptz(6)
  processedAt             DateTime?    @map("responded_at") @db.Timestamptz(6)
  note                    String?
  member                  FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reminder                Reminder     @relation(fields: [reminderId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([reminderId, memberId, scheduledAt], map: "reminder_logs_occurrence_key")
  @@index([memberId, scheduledAt(sort: Desc)], map: "idx_reminder_logs_member_time")
  @@index([notificationProcessedAt, scheduledAt], map: "idx_reminder_logs_notification_pending")
  @@map("reminder_logs")
  @@schema("public")
}

model ReminderTarget {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reminderId String       @map("reminder_id") @db.Uuid
  memberId   String       @map("member_id") @db.Uuid
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reminder   Reminder     @relation(fields: [reminderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reminderId, memberId])
  @@index([memberId], map: "idx_reminder_targets_member")
  @@map("reminder_targets")
  @@schema("public")
}

model Reminder {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId         String           @map("family_id") @db.Uuid
  creatorUserId    String           @map("created_by") @db.Uuid
  title            String           @db.VarChar(150)
  description      String?
  reminderType     String?          @map("reminder_type") @db.VarChar(30)
  startAt          DateTime         @map("start_time") @db.Timestamptz(6)
  scheduleType     String           @default("once") @map("repeat_type") @db.VarChar(30)
  scheduleRule     Json?            @map("repeat_rule")
  timezone         String           @default("UTC") @db.VarChar(100)
  endAt            DateTime?        @map("end_time") @db.Timestamptz(6)
  nextOccurrenceAt DateTime?        @map("next_occurrence_at") @db.Timestamptz(6)
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  logs             ReminderLog[]
  targets          ReminderTarget[]
  creator          Profile          @relation(fields: [creatorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  family           Family           @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([familyId], map: "idx_reminders_family")
  @@index([isActive, nextOccurrenceAt], map: "idx_reminders_due")
  @@index([creatorUserId, createdAt(sort: Desc)], map: "idx_reminders_creator_time")
  @@map("reminders")
  @@schema("public")
}

model SosContact {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId   String        @map("owner_user_id") @db.Uuid
  memberId      String?       @map("member_id") @db.Uuid
  contactUserId String?       @map("contact_user_id") @db.Uuid
  contactName   String        @map("contact_name") @db.VarChar(100)
  phone         String        @db.VarChar(20)
  priority      Int           @default(1)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner         Profile       @relation("sos_contacts_owner", fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linkedUser    Profile?      @relation("sos_contacts_linked_user", fields: [contactUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  member        FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([ownerUserId, phone], map: "sos_contacts_owner_phone_key")
  @@index([ownerUserId, priority, id], map: "idx_sos_contacts_owner_priority")
  @@index([memberId], map: "idx_sos_contacts_member")
  @@map("sos_contacts")
  @@schema("public")
}

model SosEvent {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId        String         @map("actor_user_id") @db.Uuid
  clientRequestId    String         @map("client_request_id") @db.Uuid
  requestFingerprint String         @map("request_fingerprint") @db.VarChar(64)
  familyId           String?        @map("family_id") @db.Uuid
  memberId           String?        @map("member_id") @db.Uuid
  sourceDeviceId     String?        @map("source_device_id") @db.Uuid
  sourceLocationId   String?        @map("source_location_id") @db.Uuid
  latitude           Decimal?       @db.Decimal(10, 7)
  longitude          Decimal?       @db.Decimal(10, 7)
  locationAccuracy   Float?         @map("location_accuracy")
  locationRecordedAt DateTime?      @map("location_recorded_at") @db.Timestamptz(6)
  status             String         @default("active") @db.VarChar(30)
  triggeredAt        DateTime       @default(now()) @map("triggered_at") @db.Timestamptz(6)
  resolvedAt         DateTime?      @map("resolved_at") @db.Timestamptz(6)
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  handledBy          String?        @map("handled_by") @db.Uuid
  handledAt          DateTime?      @map("handled_at") @db.Timestamptz(6)
  note               String?
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  actor              Profile        @relation("sos_events_actor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  handler            Profile?       @relation("sos_events_handled_by", fields: [handledBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  family             Family?        @relation(fields: [familyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  member             FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sourceDevice       Device?        @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sourceLocation     Location?      @relation(fields: [sourceLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recipients         SosRecipient[]

  @@unique([actorUserId, clientRequestId], map: "sos_events_actor_request_key")
  @@index([actorUserId, triggeredAt(sort: Desc), id(sort: Desc)], map: "idx_sos_events_actor_time_id")
  @@index([memberId, triggeredAt(sort: Desc)], map: "idx_sos_events_member_time")
  @@map("sos_events")
  @@schema("public")
}

model SosRecipient {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sosEventId      String   @map("sos_event_id") @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  source          String   @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sosEvent        SosEvent @relation(fields: [sosEventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipient       Profile  @relation(fields: [recipientUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sosEventId, recipientUserId])
  @@index([recipientUserId, sosEventId], map: "idx_sos_recipients_user_event")
  @@map("sos_recipients")
  @@schema("public")
}

model UserSetting {
  userId                    String    @id @map("user_id") @db.Uuid
  theme                     String?   @default("system") @db.VarChar(30)
  language                  String?   @default("vi") @db.VarChar(20)
  pushNotificationsEnabled  Boolean?  @default(true) @map("allow_push_notification")
  smsNotificationsEnabled   Boolean   @default(true) @map("sms_notifications_enabled")
  emailNotificationsEnabled Boolean   @default(true) @map("email_notifications_enabled")
  locationSharingEnabled    Boolean   @default(true) @map("location_sharing_enabled")
  darkMode                  Boolean   @default(false) @map("dark_mode")
  quietHoursStart           DateTime? @map("quiet_hours_start") @db.Time(6)
  quietHoursEnd             DateTime? @map("quiet_hours_end") @db.Time(6)
  updatedAt                 DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  Profile                   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_settings")
  @@schema("public")
}
