# SafeNet Backend Environment Configuration Example
# Copy this file to .env and provide appropriate values.

# Application
PORT=3000
NODE_ENV=development
APP_NAME=SafeNet-Backend
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Timeout per outbound Supabase Auth request (milliseconds, 1000-60000).
SUPABASE_AUTH_TIMEOUT_MS=10000

# Direct PostgreSQL connection used only by Prisma. Prefer the Supabase direct
# connection for migrations and a pooler-compatible URL for application runtime.
DATABASE_URL=

# Firebase Admin / FCM (Optional for local dev, required for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Security & Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
MAX_BODY_SIZE=1mb
CALL_RING_TIMEOUT_SECONDS=45
# Alert the family when a sharing phone goes silent (set false to disable).
SIGNAL_LOSS_ALERTS_ENABLED=true
DAILY_STATUS_DEFAULT_TIMEZONE=UTC
DAILY_STATUS_GENERATION_GRACE_MINUTES=60

# Explicit opt-in for destructive, test-scoped live Supabase verification.
# Use a dedicated non-production Supabase project and temporary test accounts.
RUN_LIVE_SUPABASE_INTEGRATION=false
# Registration/login integration: temporary accounts, no email or SMS delivery.
RUN_LIVE_SUPABASE_REGISTRATION=false
RUN_GEOFENCE_ASSIGNMENT_REGRESSION=false
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
SUPABASE_TEST_SIGNUP_EMAIL_DOMAIN=
SUPABASE_TEST_SIGNUP_PASSWORD=
